# =============================================================================
# DropVault — Environment Configuration Template (.env.example)
# =============================================================================
# This file serves as a template for environment variables across local development
# and production deployments (Vercel frontend + Render backend).
#
# DO NOT COMMIT REAL CREDENTIALS TO GIT.
# Copy this file to `.env` for local development.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND SERVER CONFIGURATION (Render / Node.js)
# -----------------------------------------------------------------------------
# PORT:
# - Local dev: defaults to 3000.
# - Production (Render): Render automatically injects its dynamic PORT at container
#   runtime. Do NOT hardcode this in Render dashboard; leave it to the platform.
PORT=3000

# NODE_ENV:
# - 'development' for local debugging.
# - 'production' on Render (optimizes Express performance, suppresses stack traces).
NODE_ENV=development

# FRONTEND_URL / CORS_ORIGIN:
# - Whitelist of allowed web origins permitted to make cross-origin requests.
# - Comma-separated list supported for multiple domains (e.g. preview + prod).
# - Local dev: http://localhost:5173
# - Production (Render): set to your Vercel deployment URL, e.g.:
#   https://dropvault.vercel.app
# - If you use Vercel preview branch deployments, you can also include:
#   https://dropvault.vercel.app,https://dropvault-git-main-yourname.vercel.app
CORS_ORIGIN=http://localhost:5173

# MONGO_URI:
# - Connection string for MongoDB Atlas database cluster with TTL index.
# - Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# - In Render dashboard, add this as a secret environment variable.
MONGO_URI=mongodb+srv://<username>:<password>@dropvault.yna5oky.mongodb.net/dropvault?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (Vercel / Vite)
# -----------------------------------------------------------------------------
# VITE_API_URL:
# - Set this in Vercel Project Settings -> Environment Variables.
# - Must point to the deployed Render backend URL (no trailing slash).
# - Example: https://dropvault-api.onrender.com
# - Local dev: leave empty to use Vite dev proxy or set to http://localhost:3000
VITE_API_URL=
